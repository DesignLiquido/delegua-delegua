{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar Dependências",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "group": "build"
    },
    {
      "label": "Compilar",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compilar"],
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Verificar",
      "type": "shell",
      "command": "npm",
      "args": ["run", "verificar"],
      "group": "test"
    },
    {
      "label": "Resumo do Roteiro",
      "type": "shell",
      "command": "npm",
      "args": ["run", "roteiro"]
    }
  ]
}
