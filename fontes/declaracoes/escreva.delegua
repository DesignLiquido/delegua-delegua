classe Escreva {
    noh: texto
    linha: número
    hashArquivo: longo
    argumentos: qualquer[]
    simboloEscreva: qualquer

    construtor(linha: número, hashArquivo: longo, argumentos: qualquer[]) {
        isto.noh = "Escreva"
        isto.linha = linha
        isto.hashArquivo = hashArquivo
        isto.argumentos = argumentos
        isto.simboloEscreva = nulo
    }

    paraTexto(): texto {
        var argumentosTexto: texto = ""
        para cada argumento em isto.argumentos {
            argumentosTexto = argumentosTexto + argumento.paraTexto()
        }

        retorna "<escreva argumentos=" + argumentosTexto + " />"
    }
}
