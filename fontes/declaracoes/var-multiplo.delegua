classe VarMultiplo {
    linha: número
    hashArquivo: longo
    simbolos: qualquer[]
    inicializador: qualquer
    _tipo: qualquer
    referencia: lógico

    construtor(simbolos: qualquer[], inicializador: qualquer, _tipo: qualquer = nulo) {
        isto.linha = simbolos[0].linha
        isto.hashArquivo = simbolos[0].hashArquivo
        isto.simbolos = simbolos
        isto.inicializador = inicializador
        isto._tipo = _tipo
        isto.referencia = falso
    }

    paraTexto(): texto {
        retorna "<var-múltiplo />"
    }
}
