classe Var {
    noh: texto
    linha: número
    hashArquivo: longo
    simbolo: qualquer
    inicializador: qualquer
    _tipo: texto
    _tipoOriginal: texto
    tipoExplicito: lógico
    referencia: lógico
    desestruturacao: lógico
    escopo: texto
    decoradores: qualquer[]

    construtor(simbolo: qualquer, inicializador: qualquer = nulo, _tipo: texto = "qualquer", tipoExplicito: lógico = falso, decoradores: qualquer[] = [], _tipoOriginal: texto = "") {
        isto.noh = "Var"
        isto.linha = simbolo.linha
        isto.hashArquivo = simbolo.hashArquivo
        isto.simbolo = simbolo
        isto.inicializador = inicializador
        isto.decoradores = decoradores
        se _tipoOriginal != "" {
            isto._tipoOriginal = _tipoOriginal
        } senao {
            isto._tipoOriginal = _tipo
        }

        se _tipo != "qualquer" {
            isto._tipo = _tipo
        } senao {
            se inicializador != nulo e inicializador._tipo != nulo {
                isto._tipo = inicializador._tipo
            } senao {
                isto._tipo = _tipo
            }
        }

        isto.tipoExplicito = tipoExplicito
        isto.referencia = falso
        isto.desestruturacao = falso
        isto.escopo = "local"
    }

    paraTexto(): texto {
        var valorTexto: texto = "Nada"
        se isto.inicializador != nulo {
            valorTexto = isto.inicializador.paraTexto()
        }

        retorna "<var nome=" + isto.simbolo.lexema + " valor=" + valorTexto + " />"
    }
}
