classe Const {
    noh: texto
    linha: número
    hashArquivo: longo
    simbolo: qualquer
    inicializador: qualquer
    _tipo: texto
    tipoExplicito: lógico
    decoradores: qualquer[]

    construtor(simbolo: qualquer, inicializador: qualquer, tipoDeclarado: texto = "qualquer", tipoExplicito: lógico = falso, decoradores: qualquer[] = []) {
        isto.noh = "Const"
        isto.linha = simbolo.linha
        isto.hashArquivo = simbolo.hashArquivo
        isto.simbolo = simbolo
        isto.inicializador = inicializador
        isto.decoradores = decoradores
        se tipoDeclarado != "qualquer" {
            isto._tipo = tipoDeclarado
        } senao {
            se inicializador != nulo e inicializador._tipo != nulo {
                isto._tipo = inicializador._tipo
            } senao {
                isto._tipo = tipoDeclarado
            }
        }
        isto.tipoExplicito = tipoExplicito
    }

    paraTexto(): texto {
        var tipoExplicitoTexto: texto = "Não"
        se isto.tipoExplicito {
            tipoExplicitoTexto = "Sim"
        }

        retorna "<const nome=" + isto.simbolo.lexema + " inicializador=" + isto.inicializador.paraTexto() + " tipo=" + isto._tipo + " tipoExplícito=" + tipoExplicitoTexto + " />"
    }
}
