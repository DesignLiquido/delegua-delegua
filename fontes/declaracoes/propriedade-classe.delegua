classe PropriedadeClasse {
    linha: número
    hashArquivo: longo
    nome: qualquer
    _tipo: qualquer
    decoradores: qualquer[]
    acesso: texto
    _estatico: lógico
    autoObter: lógico
    autoDefinir: lógico
    documentacao: qualquer
    valorInicial: qualquer

    construtor(nome: qualquer, _tipo: qualquer = nulo, decoradores: qualquer[] = [], acesso: texto = "publico", _estatico: lógico = falso, valorInicial: qualquer = nulo) {
        isto.linha = nome.linha
        isto.hashArquivo = nome.hashArquivo
        isto.nome = nome
        isto._tipo = _tipo
        isto.decoradores = decoradores
        isto.acesso = acesso
        isto._estatico = _estatico
        isto.autoObter = falso
        isto.autoDefinir = falso
        isto.documentacao = nulo
        isto.valorInicial = valorInicial
    }

    paraTexto(): texto {
        retorna "<propriedade-classe nome=" + isto.nome.lexema + " tipo=" + isto._tipo + " />"
    }
}
