classe Tente {
    noh: texto
    linha: número
    hashArquivo: longo
    caminhoTente: qualquer[]
    caminhoPegue: qualquer
    caminhoSenao: qualquer[]
    caminhoFinalmente: qualquer[]

    construtor(hashArquivo: longo, linha: número, caminhoTente: qualquer[], caminhoPegue: qualquer, caminhoSenao: qualquer[], caminhoFinalmente: qualquer[]) {
        isto.noh = "Tente"
        isto.hashArquivo = hashArquivo
        isto.linha = linha
        isto.caminhoTente = caminhoTente
        isto.caminhoPegue = caminhoPegue
        isto.caminhoSenao = caminhoSenao
        isto.caminhoFinalmente = caminhoFinalmente
    }

    paraTexto(): texto {
        retorna "<tente />"
    }
}
