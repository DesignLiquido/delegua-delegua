classe AssinaturaMetodo {
    nome: qualquer
    parametros: qualquer[]
    tipoRetorno: qualquer

    construtor(nome: qualquer, parametros: qualquer[] = [], tipoRetorno: qualquer = nulo) {
        isto.nome = nome
        isto.parametros = parametros
        isto.tipoRetorno = tipoRetorno
    }
}

classe InterfaceDeclaracao {
    linha: número
    hashArquivo: longo
    simbolo: qualquer
    metodos: qualquer[]
    propriedades: qualquer[]

    construtor(simbolo: qualquer, metodos: qualquer[] = [], propriedades: qualquer[] = []) {
        isto.linha = simbolo.linha
        isto.hashArquivo = simbolo.hashArquivo
        isto.simbolo = simbolo
        isto.metodos = metodos
        isto.propriedades = propriedades
    }

    paraTexto(): texto {
        var resultado: texto = "<interface nome=" + isto.simbolo.lexema + ">"
        para cada propriedade em isto.propriedades {
            resultado = resultado + propriedade.paraTexto()
        }

        para cada metodo em isto.metodos {
            resultado = resultado + "<assinatura-metodo nome=" + metodo.nome.lexema + " />"
        }

        retorna resultado + "</interface>"
    }
}
