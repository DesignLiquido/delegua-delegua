classe Expressao {
    linha: número
    hashArquivo: longo
    expressao: qualquer
    decoradores: qualquer[]

    construtor(expressao: qualquer, decoradores: qualquer[] = []) {
        isto.linha = expressao.linha
        isto.hashArquivo = expressao.hashArquivo
        isto.expressao = expressao
        isto.decoradores = decoradores
    }

    paraTexto(): texto {
        retorna "<declaração-expressão subExpressao=" + isto.expressao.paraTexto() + " />"
    }
}
