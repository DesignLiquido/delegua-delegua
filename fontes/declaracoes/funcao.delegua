classe FuncaoDeclaracao {
    linha: número
    hashArquivo: longo
    simbolo: qualquer
    _funcao: qualquer
    _tipo: texto
    decoradores: qualquer[]
    id: texto
    acesso: texto
    _estatico: lógico
    _abstrato: lógico
    eObtenedor: lógico
    eDefinidor: lógico
    eFuncaoDeDecorador: lógico
    documentacao: qualquer

    construtor(simbolo: qualquer, _funcao: qualquer, tipoRetorno: texto = "qualquer", decoradores: qualquer[] = [], acesso: texto = "publico", _estatico: lógico = falso, _abstrato: lógico = falso, eObtenedor: lógico = falso, eDefinidor: lógico = falso, eFuncaoDeDecorador: lógico = falso) {
        isto.linha = simbolo.linha
        isto.hashArquivo = simbolo.hashArquivo
        isto.id = "funcao-" + simbolo.lexema + "-" + texto(simbolo.linha)
        isto.simbolo = simbolo
        isto._funcao = _funcao
        isto._tipo = tipoRetorno
        isto.decoradores = decoradores
        isto.acesso = acesso
        isto._estatico = _estatico
        isto._abstrato = _abstrato
        isto.eObtenedor = eObtenedor
        isto.eDefinidor = eDefinidor
        isto.eFuncaoDeDecorador = eFuncaoDeDecorador
        isto.documentacao = nulo
    }

    paraTexto(): texto {
        retorna "<declaração-função nome=" + isto.simbolo.lexema + " tipo=" + isto._tipo + " />"
    }
}
