classe TendoComo {
    linha: número
    hashArquivo: longo
    simboloVariavel: qualquer
    inicializacaoVariavel: qualquer
    corpo: qualquer

    construtor(linha: número, hashArquivo: longo, simboloVariavel: qualquer, inicializacaoVariavel: qualquer, corpo: qualquer) {
        isto.linha = linha
        isto.hashArquivo = hashArquivo
        isto.simboloVariavel = simboloVariavel
        isto.inicializacaoVariavel = inicializacaoVariavel
        isto.corpo = corpo
    }

    paraTexto(): texto {
        retorna "<tendo variável=" + isto.simboloVariavel.lexema + " como=" + isto.inicializacaoVariavel.paraTexto() + " />"
    }
}
