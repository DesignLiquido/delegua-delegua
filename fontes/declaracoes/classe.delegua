classe Classe {
    noh: texto
    linha: número
    hashArquivo: longo
    simbolo: qualquer
    superClasses: qualquer[]
    mesclas: qualquer[]
    metodos: qualquer[]
    propriedades: qualquer[]
    decoradores: qualquer[]
    documentacao: qualquer
    _abstrata: lógico
    _estrangeira: lógico
    classeEstatica: lógico
    interfaces: qualquer[]

    construtor(simbolo: qualquer, superClasses: qualquer[] = [], metodos: qualquer[] = [], propriedades: qualquer[] = [], decoradores: qualquer[] = [], _abstrata: lógico = falso, _estrangeira: lógico = falso, classeEstatica: lógico = falso, interfaces: qualquer[] = [], mesclas: qualquer[] = []) {
        isto.noh = "Classe"
        isto.linha = simbolo.linha
        isto.hashArquivo = simbolo.hashArquivo
        isto.simbolo = simbolo
        isto.superClasses = superClasses
        isto.mesclas = mesclas
        isto.metodos = metodos
        isto.propriedades = propriedades
        isto.decoradores = decoradores
        isto.documentacao = nulo
        isto._abstrata = _abstrata
        isto._estrangeira = _estrangeira
        isto.classeEstatica = classeEstatica
        isto.interfaces = interfaces
    }

    superClasse(): qualquer {
        se isto.superClasses.tamanho() > 0 {
            retorna isto.superClasses[0]
        }

        retorna nulo
    }

    paraTexto(): texto {
        var resultado: texto = "<classe nome=" + isto.simbolo.lexema + " "
        se isto.superClasses.tamanho() > 0 {
            resultado = resultado + "herda="
            para cada superClasse em isto.superClasses {
                se superClasse.simbolo != nulo {
                    resultado = resultado + superClasse.simbolo.lexema + ", "
                } senao {
                    resultado = resultado + superClasse + ", "
                }
            }
        }

        se isto.mesclas.tamanho() > 0 {
            resultado = resultado + "mescla="
            para cada mesclaAtual em isto.mesclas {
                se mesclaAtual.simbolo != nulo {
                    resultado = resultado + mesclaAtual.simbolo.lexema + ", "
                } senao {
                    resultado = resultado + mesclaAtual + ", "
                }
            }
        }

        resultado = resultado + ">"
        para cada propriedade em isto.propriedades {
            resultado = resultado + propriedade.paraTexto()
        }

        para cada metodo em isto.metodos {
            resultado = resultado + metodo.paraTexto()
        }

        retorna resultado + "</classe>"
    }
}
