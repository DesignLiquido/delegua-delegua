importar { Simbolo } de "../lexador/simbolo.delegua"
importar { Construto } de "../construtos/construto.delegua"

classe Declaracao {
    noh: texto
    linha: número
    hashArquivo: longo

    // ComandoExpressao
    expressaoComando: Construto

    // ComandoBloco
    blocoDeclaracoes: Declaracao[]

    // DeclaracaoVariavel
    variavelNome: Simbolo
    variavelInicializador: Construto

    construtor(noh: texto) {
        isto.noh = noh
        isto.linha = 0
        isto.hashArquivo = 0
    }

    paraTexto(): texto {
        retorna "Declaracao(" + isto.noh + ")"
    }
}
