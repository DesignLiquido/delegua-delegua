importar { Simbolo } de "../lexador/simbolo.delegua"

classe Logico {
    esquerda: qualquer
    _operador: Simbolo
    direita: qualquer

    construtor(esquerda: qualquer, _operador: Simbolo, direita: qualquer) {
        isto.esquerda = esquerda
        isto._operador = _operador
        isto.direita = direita
    }

    paraTexto(): texto {
        retorna "<logico />"
    }
}
