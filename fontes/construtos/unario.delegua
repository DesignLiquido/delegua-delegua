importar { Simbolo } de "../lexador/simbolo.delegua"

classe Unario {
    _operador: Simbolo
    operando: qualquer
    posicao: texto

    construtor(_operador: Simbolo, operando: qualquer, posicao: texto) {
        isto._operador = _operador
        isto.operando = operando
        isto.posicao = posicao
    }

    paraTexto(): texto {
        retorna "<unario />"
    }
}
