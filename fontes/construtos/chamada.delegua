classe Chamada {
    noh: texto
    entidadeChamada: qualquer
    argumentos: qualquer[]

    construtor(entidadeChamada: qualquer, argumentos: qualquer[]) {
        isto.noh = "Chamada"
        isto.entidadeChamada = entidadeChamada
        isto.argumentos = argumentos
    }

    paraTexto(): texto {
        retorna "<chamada />"
    }
}
