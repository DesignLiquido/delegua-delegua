importar { Simbolo } de "../lexador/simbolo.delegua"

classe Variavel {
    noh: texto
    simbolo: Simbolo

    construtor(simbolo: Simbolo) {
        isto.noh = "Variavel"
        isto.simbolo = simbolo
    }

    paraTexto(): texto {
        var lexema: texto = isto.simbolo.lexema
        retorna "<variavel lexema=${lexema} />"
    }
}
