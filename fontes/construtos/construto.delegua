importar { Simbolo } de "../lexador/simbolo.delegua"

classe Construto {
    noh: texto

    // Literal (tipoLiteral discrimina qual dos três campos abaixo é válido)
    tipoLiteral: texto
    literalNumero: número
    literalTexto: texto
    literalLogico: lógico

    // Binario / Logico
    esquerda: Construto
    simboloOperador: Simbolo
    direita: Construto

    // Unario
    operando: Construto
    posicaoUnario: texto

    // Variavel
    simbolo: Simbolo

    // Chamada
    entidadeChamada: Construto
    argumentos: Construto[]

    // Agrupamento
    expressao: Construto

    // Atribuicao
    alvoAtribuicao: Construto
    valorAtribuicao: Construto

    // Vetor: [a, b]
    elementos: Construto[]

    // Dicionario: {chave: valor}; chavesDicionario[i] corresponde a valoresDicionario[i]
    chavesDicionario: Construto[]
    valoresDicionario: Construto[]

    // AcessoIndice: objetoAcessado[indice]
    // AcessoMembro: objetoAcessado.nomeMembro (método de primitiva, quando chamado)
    objetoAcessado: Construto
    indice: Construto
    nomeMembro: texto

    // FuncaoAnonima: a declaração (DeclaracaoFuncao sem nome). Fica como `qualquer` porque
    // Declaracao já importa Construto.
    funcaoAnonima: qualquer

    // Isto / Super. Em `super.metodo(...)`, nomeMembro é o método; em `super(...)`, "".

    // Linha do símbolo que inicia o construto (para mensagens de erro).
    linha: número

    construtor(noh: texto) {
        isto.noh = noh
        isto.linha = 0
    }

    paraTexto(): texto {
        retorna "<construto noh=${isto.noh} />"
    }
}
