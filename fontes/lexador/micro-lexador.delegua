importar { Simbolo } de "./simbolo.delegua"
importar { ErroLexador } de "./erro-lexador.delegua"
importar { RetornoLexador } de "./retorno-lexador.delegua"
importar { TiposSimbolos } de "./tipos-simbolos.delegua"
importar { PalavrasReservadas } de "./palavras-reservadas.delegua"

classe MicroLexador {
    simbolos: Simbolo[]
    erros: ErroLexador[]
    inicioSimbolo: inteiro
    atual: inteiro
    codigo: texto
    tipos: TiposSimbolos
    palavrasReservadas: PalavrasReservadas

    construtor() {
        isto.tipos = TiposSimbolos()
        isto.palavrasReservadas = PalavrasReservadas()
        isto.simbolos = []
        isto.erros = []
        isto.inicioSimbolo = 0
        isto.atual = 0
        isto.codigo = ""
    }

    eDigito(caractere: texto): lógico {
        retorna caractere >= "0" e caractere <= "9"
    }

    eAlfabeto(caractere: texto): lógico {
        var acentuacoes: texto[] = ["á", "Á", "ã", "Ã", "â", "Â", "à", "À", "é", "É", "ê", "Ê", "í", "Í", "ó", "Ó", "õ", "Õ", "ô", "Ô", "ú", "Ú", "ç", "Ç", "_"]
        retorna (caractere >= "a" e caractere <= "z") ou (caractere >= "A" e caractere <= "Z") ou acentuacoes.inclui(caractere)
    }

    eAlfabetoOuDigito(caractere: texto): lógico {
        retorna isto.eDigito(caractere) ou isto.eAlfabeto(caractere)
    }

    eFinalDoCodigo(): lógico {
        retorna isto.codigo.tamanho() <= isto.atual
    }

    adicionarSimbolo(tipoSimbolo: texto, lexema: texto): nulo {
        var trecho: texto = isto.codigo.subtexto(isto.inicioSimbolo, isto.atual)
        var lexemaFinal: texto = lexema
        se lexema == "" {
            lexemaFinal = trecho
        }
        var comprimentoLexema: inteiro = lexemaFinal.tamanho()
        var comprimentoTrecho: inteiro = trecho.tamanho()
        var comprimento: inteiro = maximo(comprimentoLexema, comprimentoTrecho)
        se comprimento <= 0 {
            comprimento = 1
        }
        var novoSimbolo: Simbolo = Simbolo(lexemaFinal, tipoSimbolo, 1, -1)
        isto.simbolos.adicionar(novoSimbolo)
    }

    analisarTexto(delimitador: texto): nulo {
        enquanto isto.codigo[isto.atual] != delimitador e nao isto.eFinalDoCodigo() {
            isto.atual = isto.atual + 1
        }

        se isto.eFinalDoCodigo() {
            var novoErro: ErroLexador = ErroLexador("Texto não finalizado.", 1)
            isto.erros.adicionar(novoErro)
            retorna
        }

        var valor: texto = isto.codigo.subtexto(isto.inicioSimbolo + 1, isto.atual)
        isto.adicionarSimbolo(isto.tipos.TEXTO, valor)
    }

    analisarNumero(): nulo {
        enquanto nao isto.eFinalDoCodigo() e isto.eDigito(isto.codigo[isto.atual]) {
            isto.atual = isto.atual + 1
        }

        se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "." {
            var proximoIndice: inteiro = isto.atual + 1
            se nao isto.eFinalDoCodigo() e isto.eDigito(isto.codigo[proximoIndice]) {
                isto.atual = isto.atual + 1
                enquanto nao isto.eFinalDoCodigo() e isto.eDigito(isto.codigo[isto.atual]) {
                    isto.atual = isto.atual + 1
                }
            }
        }

        var numeroCompleto: texto = isto.codigo.subtexto(isto.inicioSimbolo, isto.atual)
        isto.adicionarSimbolo(isto.tipos.NUMERO, numeroCompleto)
    }

    identificarPalavraChave(): nulo {
        enquanto nao isto.eFinalDoCodigo() e isto.eAlfabetoOuDigito(isto.codigo[isto.atual]) {
            isto.atual = isto.atual + 1
        }

        var palavra: texto = isto.codigo.subtexto(isto.inicioSimbolo, isto.atual)
        var tipoToken: texto = isto.palavrasReservadas.buscar(palavra)
        isto.adicionarSimbolo(tipoToken, "")
    }

    analisarToken(): nulo {
        var caractere: texto = isto.codigo[isto.atual]

        escolha caractere {
            caso "(":
                isto.adicionarSimbolo(isto.tipos.PARENTESE_ESQUERDO, "")
                isto.atual = isto.atual + 1
            caso ")":
                isto.adicionarSimbolo(isto.tipos.PARENTESE_DIREITO, "")
                isto.atual = isto.atual + 1
            caso "[":
                isto.adicionarSimbolo(isto.tipos.COLCHETE_ESQUERDO, "")
                isto.atual = isto.atual + 1
            caso "]":
                isto.adicionarSimbolo(isto.tipos.COLCHETE_DIREITO, "")
                isto.atual = isto.atual + 1
            caso "{":
                isto.adicionarSimbolo(isto.tipos.CHAVE_ESQUERDA, "")
                isto.atual = isto.atual + 1
            caso "}":
                isto.adicionarSimbolo(isto.tipos.CHAVE_DIREITA, "")
                isto.atual = isto.atual + 1
            caso ",":
                isto.adicionarSimbolo(isto.tipos.VIRGULA, "")
                isto.atual = isto.atual + 1
            caso ".":
                isto.adicionarSimbolo(isto.tipos.PONTO, "")
                isto.atual = isto.atual + 1
            caso ":":
                isto.adicionarSimbolo(isto.tipos.DOIS_PONTOS, "")
                isto.atual = isto.atual + 1
            caso "!":
                isto.adicionarSimbolo(isto.tipos.NEGACAO, "")
                isto.atual = isto.atual + 1
            caso "~":
                isto.adicionarSimbolo(isto.tipos.BIT_NOT, "")
                isto.atual = isto.atual + 1
            caso "%":
                isto.adicionarSimbolo(isto.tipos.MODULO, "")
                isto.atual = isto.atual + 1
            caso "\\":
                isto.adicionarSimbolo(isto.tipos.DIVISAO_INTEIRA, "")
                isto.atual = isto.atual + 1
            caso "+":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "+" {
                    isto.adicionarSimbolo(isto.tipos.INCREMENTAR, "")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.ADICAO, "")
                }
            caso "-":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "-" {
                    isto.adicionarSimbolo(isto.tipos.DECREMENTAR, "")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.SUBTRACAO, "")
                }
            caso "*":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "*" {
                    isto.adicionarSimbolo(isto.tipos.EXPONENCIACAO, "")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.MULTIPLICACAO, "")
                }
            caso "/":
                isto.adicionarSimbolo(isto.tipos.DIVISAO, "")
                isto.atual = isto.atual + 1
            caso "?":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == ":" {
                    isto.adicionarSimbolo(isto.tipos.ELVIS, "?:")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.INTERROGACAO, "")
                }
            caso "<":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "=" {
                    isto.adicionarSimbolo(isto.tipos.MENOR_IGUAL, "")
                    isto.atual = isto.atual + 1
                } senão se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "<" {
                    isto.adicionarSimbolo(isto.tipos.MENOR_MENOR, "")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.MENOR, "")
                }
            caso ">":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "=" {
                    isto.adicionarSimbolo(isto.tipos.MAIOR_IGUAL, "")
                    isto.atual = isto.atual + 1
                } senão se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == ">" {
                    isto.adicionarSimbolo(isto.tipos.MAIOR_MAIOR, "")
                    isto.atual = isto.atual + 1
                } senão {
                    isto.adicionarSimbolo(isto.tipos.MAIOR, "")
                }
            caso "=":
                isto.atual = isto.atual + 1
                se nao isto.eFinalDoCodigo() e isto.codigo[isto.atual] == "=" {
                    isto.adicionarSimbolo(isto.tipos.IGUAL_IGUAL, "")
                    isto.atual = isto.atual + 1
                }
            caso "&":
                isto.adicionarSimbolo(isto.tipos.BIT_AND, "")
                isto.atual = isto.atual + 1
            caso "|":
                isto.adicionarSimbolo(isto.tipos.BIT_OR, "")
                isto.atual = isto.atual + 1
            caso "^":
                isto.adicionarSimbolo(isto.tipos.BIT_XOR, "")
                isto.atual = isto.atual + 1
            caso " ":
                isto.atual = isto.atual + 1
            caso "\r":
                isto.atual = isto.atual + 1
            caso "\t":
                isto.atual = isto.atual + 1
            caso "\"":
                isto.atual = isto.atual + 1
                isto.analisarTexto("\"")
                isto.atual = isto.atual + 1
            caso "'":
                isto.atual = isto.atual + 1
                isto.analisarTexto("'")
                isto.atual = isto.atual + 1
            padrão:
                se isto.eDigito(caractere) {
                    isto.analisarNumero()
                } senão se isto.eAlfabeto(caractere) {
                    isto.identificarPalavraChave()
                } senão {
                    var novoErro: ErroLexador = ErroLexador("Caractere inesperado.", 1)
                    isto.erros.adicionar(novoErro)
                    isto.atual = isto.atual + 1
                }
        }
    }

    mapear(codigoFonte: texto): RetornoLexador {
        isto.codigo = codigoFonte
        isto.erros = []
        isto.simbolos = []
        isto.atual = 0
        isto.inicioSimbolo = 0

        enquanto nao isto.eFinalDoCodigo() {
            isto.inicioSimbolo = isto.atual
            isto.analisarToken()
        }

        retorna RetornoLexador(isto.simbolos, isto.erros)
    }
}
