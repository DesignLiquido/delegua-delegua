importar { Simbolo } de "../lexador/simbolo.delegua"
importar { ErroAvaliadorSintatico } de "./erro-avaliador-sintatico.delegua"
importar { RetornoAvaliadorSintatico } de "./retorno-avaliador-sintatico.delegua"
importar { TiposSimbolos } de "../lexador/tipos-simbolos.delegua"
importar { Construto } de "../construtos/construto.delegua"
importar { Declaracao } de "../declaracoes/declaracao.delegua"

classe AvaliadorSintatico {
    simbolos: Simbolo[]
    erros: ErroAvaliadorSintatico[]
    atual: inteiro
    linha: inteiro
    tipos: TiposSimbolos

    construtor() {
        isto.simbolos = []
        isto.erros = []
        isto.atual = 0
        isto.linha = 1
        isto.tipos = TiposSimbolos()
    }

    terminou(): lógico {
        retorna isto.atual >= isto.simbolos.tamanho() ou isto.simbolos[isto.atual]._tipo == isto.tipos.EOF
    }

    simboloAtual(): Simbolo {
        retorna isto.simbolos[isto.atual]
    }

    simboloAnterior(): Simbolo {
        retorna isto.simbolos[isto.atual - 1]
    }

    avancarEDevolverAnterior(): Simbolo {
        se nao isto.terminou() {
            isto.atual = isto.atual + 1
        }
        retorna isto.simboloAnterior()
    }

    verificarTipoSimboloAtual(tipoEsperado: texto): lógico {
        se isto.terminou() {
            retorna falso
        }

        retorna isto.simboloAtual()._tipo == tipoEsperado
    }

    verificarSeSimboloAtualEIgualA(tipoEsperado: texto): lógico {
        se isto.verificarTipoSimboloAtual(tipoEsperado) {
            isto.avancarEDevolverAnterior()
            retorna verdadeiro
        }

        retorna falso
    }

    verificarSeSimboloAtualCorresponde(tiposEsperados: texto[]): lógico {
        var indice: inteiro = 0
        enquanto indice < tiposEsperados.tamanho() {
            se isto.verificarSeSimboloAtualEIgualA(tiposEsperados[indice]) {
                retorna verdadeiro
            }

            indice = indice + 1
        }

        retorna falso
    }

    erro(simbolo: Simbolo, mensagem: texto): ErroAvaliadorSintatico {
        var excecao: ErroAvaliadorSintatico = ErroAvaliadorSintatico(simbolo, mensagem)
        isto.erros.adicionar(excecao)
        retorna excecao
    }

    consumir(tipoEsperado: texto, mensagemDeErro: texto): Simbolo {
        se isto.verificarTipoSimboloAtual(tipoEsperado) {
            retorna isto.avancarEDevolverAnterior()
        }

        isto.erro(isto.simboloAtual(), mensagemDeErro)
        retorna isto.simboloAtual()
    }

    analisarPrimario(): Construto {
        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.FALSO) {
            var noFalso: Construto = Construto("Literal")
            noFalso.tipoLiteral = "logico"
            noFalso.literalLogico = falso
            retorna noFalso
        }

        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.VERDADEIRO) {
            var noVerdadeiro: Construto = Construto("Literal")
            noVerdadeiro.tipoLiteral = "logico"
            noVerdadeiro.literalLogico = verdadeiro
            retorna noVerdadeiro
        }

        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.NULO) {
            var noNulo: Construto = Construto("Literal")
            noNulo.tipoLiteral = "nulo"
            retorna noNulo
        }

        se isto.verificarSeSimboloAtualCorresponde([isto.tipos.NUMERO, isto.tipos.TEXTO]) {
            var simboloLiteral: Simbolo = isto.simboloAnterior()
            var noLiteral: Construto = Construto("Literal")
            se simboloLiteral._tipo == isto.tipos.NUMERO {
                noLiteral.tipoLiteral = "numero"
                noLiteral.literalNumero = numero(simboloLiteral.lexema)
            } senao {
                noLiteral.tipoLiteral = "texto"
                noLiteral.literalTexto = simboloLiteral.lexema
            }
            retorna noLiteral
        }

        // ESCREVA/TIPO são palavras reservadas no lexador, mas funcionam como nomes de
        // função nativa comum (ver Interpretador.chamarNativo) — tratadas como identificador.
        se isto.verificarSeSimboloAtualCorresponde([isto.tipos.IDENTIFICADOR, isto.tipos.ESCREVA, isto.tipos.TIPO]) {
            var noVariavel: Construto = Construto("Variavel")
            noVariavel.simbolo = isto.simboloAnterior()
            retorna noVariavel
        }

        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.PARENTESE_ESQUERDO) {
            var expressao: Construto = isto.analisarExpressao()
            isto.consumir(isto.tipos.PARENTESE_DIREITO, "Esperado ')' após expressão.")
            var noAgrupamento: Construto = Construto("Agrupamento")
            noAgrupamento.expressao = expressao
            retorna noAgrupamento
        }

        isto.erro(isto.simboloAtual(), "Esperada expressão.")
        retorna nulo
    }

    analisarChamada(): Construto {
        var expressao: Construto = isto.analisarPrimario()
        se expressao == nulo {
            retorna nulo
        }

        var continuarChamando: lógico = verdadeiro
        enquanto continuarChamando {
            se isto.verificarSeSimboloAtualEIgualA(isto.tipos.PARENTESE_ESQUERDO) {
                var argumentos: Construto[] = []

                se nao isto.verificarTipoSimboloAtual(isto.tipos.PARENTESE_DIREITO) {
                    var lerMaisArgumentos: lógico = verdadeiro
                    enquanto lerMaisArgumentos {
                        var argumento: Construto = isto.analisarExpressao()
                        se argumento == nulo {
                            retorna nulo
                        }

                        argumentos.adicionar(argumento)
                        lerMaisArgumentos = isto.verificarSeSimboloAtualEIgualA(isto.tipos.VIRGULA)
                    }
                }

                isto.consumir(isto.tipos.PARENTESE_DIREITO, "Esperado ')' após argumentos.")
                var noChamada: Construto = Construto("Chamada")
                noChamada.entidadeChamada = expressao
                noChamada.argumentos = argumentos
                expressao = noChamada
            } senao {
                continuarChamando = falso
            }
        }

        retorna expressao
    }

    analisarUnario(): Construto {
        se isto.verificarSeSimboloAtualCorresponde([isto.tipos.NEGACAO, isto.tipos.SUBTRACAO]) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarUnario()
            se direita == nulo {
                retorna nulo
            }

            var noUnario: Construto = Construto("Unario")
            noUnario.simboloOperador = operadorAtual
            noUnario.operando = direita
            noUnario.posicaoUnario = "ANTES"
            retorna noUnario
        }

        retorna isto.analisarChamada()
    }

    analisarExponenciacao(): Construto {
        var expressao: Construto = isto.analisarUnario()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualEIgualA(isto.tipos.EXPONENCIACAO) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarExponenciacao()
            se direita == nulo {
                retorna nulo
            }

            var noBinario: Construto = Construto("Binario")
            noBinario.esquerda = expressao
            noBinario.simboloOperador = operadorAtual
            noBinario.direita = direita
            expressao = noBinario
        }

        retorna expressao
    }

    analisarFator(): Construto {
        var expressao: Construto = isto.analisarExponenciacao()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualCorresponde([
            isto.tipos.MULTIPLICACAO,
            isto.tipos.DIVISAO,
            isto.tipos.DIVISAO_INTEIRA,
            isto.tipos.MODULO
        ]) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarExponenciacao()
            se direita == nulo {
                retorna nulo
            }

            var noBinario: Construto = Construto("Binario")
            noBinario.esquerda = expressao
            noBinario.simboloOperador = operadorAtual
            noBinario.direita = direita
            expressao = noBinario
        }

        retorna expressao
    }

    analisarTermo(): Construto {
        var expressao: Construto = isto.analisarFator()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualCorresponde([isto.tipos.ADICAO, isto.tipos.SUBTRACAO]) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarFator()
            se direita == nulo {
                retorna nulo
            }

            var noBinario: Construto = Construto("Binario")
            noBinario.esquerda = expressao
            noBinario.simboloOperador = operadorAtual
            noBinario.direita = direita
            expressao = noBinario
        }

        retorna expressao
    }

    analisarComparacao(): Construto {
        var expressao: Construto = isto.analisarTermo()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualCorresponde([
            isto.tipos.MAIOR,
            isto.tipos.MAIOR_IGUAL,
            isto.tipos.MENOR,
            isto.tipos.MENOR_IGUAL
        ]) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarTermo()
            se direita == nulo {
                retorna nulo
            }

            var noBinario: Construto = Construto("Binario")
            noBinario.esquerda = expressao
            noBinario.simboloOperador = operadorAtual
            noBinario.direita = direita
            expressao = noBinario
        }

        retorna expressao
    }

    analisarIgualdade(): Construto {
        var expressao: Construto = isto.analisarComparacao()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualCorresponde([isto.tipos.DIFERENTE, isto.tipos.IGUAL_IGUAL]) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarComparacao()
            se direita == nulo {
                retorna nulo
            }

            var noBinario: Construto = Construto("Binario")
            noBinario.esquerda = expressao
            noBinario.simboloOperador = operadorAtual
            noBinario.direita = direita
            expressao = noBinario
        }

        retorna expressao
    }

    analisarELogico(): Construto {
        var expressao: Construto = isto.analisarIgualdade()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualEIgualA(isto.tipos.E) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarIgualdade()
            se direita == nulo {
                retorna nulo
            }

            var noLogico: Construto = Construto("Logico")
            noLogico.esquerda = expressao
            noLogico.simboloOperador = operadorAtual
            noLogico.direita = direita
            expressao = noLogico
        }

        retorna expressao
    }

    analisarOuLogico(): Construto {
        var expressao: Construto = isto.analisarELogico()
        se expressao == nulo {
            retorna nulo
        }

        enquanto isto.verificarSeSimboloAtualEIgualA(isto.tipos.OU) {
            var operadorAtual: Simbolo = isto.simboloAnterior()
            var direita: Construto = isto.analisarELogico()
            se direita == nulo {
                retorna nulo
            }

            var noLogico: Construto = Construto("Logico")
            noLogico.esquerda = expressao
            noLogico.simboloOperador = operadorAtual
            noLogico.direita = direita
            expressao = noLogico
        }

        retorna expressao
    }

    analisarAtribuicao(): Construto {
        var expressao: Construto = isto.analisarOuLogico()
        se expressao == nulo {
            retorna nulo
        }

        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.IGUAL) {
            var valor: Construto = isto.analisarAtribuicao()
            se valor == nulo {
                retorna nulo
            }

            var noAtribuicao: Construto = Construto("Atribuicao")
            noAtribuicao.alvoAtribuicao = expressao
            noAtribuicao.valorAtribuicao = valor
            retorna noAtribuicao
        }

        retorna expressao
    }

    analisarExpressao(): Construto {
        retorna isto.analisarAtribuicao()
    }

    analisarComandoExpressao(): Declaracao {
        var expressao: Construto = isto.analisarExpressao()
        se expressao == nulo {
            retorna nulo
        }

        isto.consumir(isto.tipos.PONTO_E_VIRGULA, "Esperado ';' após expressão.")
        var noComando: Declaracao = Declaracao("ComandoExpressao")
        noComando.expressaoComando = expressao
        retorna noComando
    }

    analisarBloco(): Declaracao {
        var declaracoes: Declaracao[] = []

        enquanto nao isto.verificarTipoSimboloAtual(isto.tipos.CHAVE_DIREITA) e nao isto.terminou() {
            var declaracao: Declaracao = isto.analisarDeclaracao()
            se declaracao == nulo {
                retorna nulo
            }
            declaracoes.adicionar(declaracao)
        }

        isto.consumir(isto.tipos.CHAVE_DIREITA, "Esperado '}' após bloco.")
        var noBloco: Declaracao = Declaracao("ComandoBloco")
        noBloco.blocoDeclaracoes = declaracoes
        retorna noBloco
    }

    analisarDeclaracaoVariavel(): Declaracao {
        var nome: Simbolo = isto.consumir(isto.tipos.IDENTIFICADOR, "Esperado nome da variável.")

        var inicializador: Construto = nulo
        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.IGUAL) {
            inicializador = isto.analisarExpressao()
            se inicializador == nulo {
                retorna nulo
            }
        }

        isto.consumir(isto.tipos.PONTO_E_VIRGULA, "Esperado ';' após declaração de variável.")
        var noDeclaracaoVariavel: Declaracao = Declaracao("DeclaracaoVariavel")
        noDeclaracaoVariavel.variavelNome = nome
        noDeclaracaoVariavel.variavelInicializador = inicializador
        retorna noDeclaracaoVariavel
    }

    analisarComando(): Declaracao {
        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.CHAVE_ESQUERDA) {
            retorna isto.analisarBloco()
        }

        retorna isto.analisarComandoExpressao()
    }

    analisarDeclaracao(): Declaracao {
        se isto.verificarSeSimboloAtualEIgualA(isto.tipos.VARIAVEL) {
            retorna isto.analisarDeclaracaoVariavel()
        }

        retorna isto.analisarComando()
    }

    analisar(simbolos: Simbolo[]): RetornoAvaliadorSintatico {
        isto.simbolos = simbolos
        isto.erros = []
        isto.atual = 0

        var declaracoes: Declaracao[] = []
        var continuarAnalisando: lógico = verdadeiro
        enquanto continuarAnalisando e nao isto.terminou() {
            var declaracao: Declaracao = isto.analisarDeclaracao()
            se declaracao == nulo {
                continuarAnalisando = falso
            } senao {
                declaracoes.adicionar(declaracao)
            }
        }

        var retorno: RetornoAvaliadorSintatico = RetornoAvaliadorSintatico()
        retorno.declaracoes = declaracoes
        retorno.erros = []
        para cada erro em isto.erros {
            retorno.erros.adicionar(erro.paraTexto())
        }
        retorna retorno
    }

    mapear(simbolos: Simbolo[]) {
        // AFAZER: Implementar corpo de `mapear`.
    }
}
