importar { Declaracao } de "../declaracoes/declaracao.delegua"
importar { ErroAvaliadorSintatico } de "./erro-avaliador-sintatico.delegua"

classe RetornoAvaliadorSintatico {
    declaracoes: Declaracao[]
    erros: texto[]
    // Os mesmos erros, com o símbolo onde ocorreram (linha), para mensagens formatadas.
    errosDetalhados: ErroAvaliadorSintatico[]

    construtor() {
        isto.declaracoes = []
        isto.erros = []
        isto.errosDetalhados = []
    }

    paraTexto(): texto {
        var texto: texto = "RetornoAvaliadorSintatico {\n"
        texto += "  declaracoes: [\n"
        para cada declaracao em isto.declaracoes {
            texto += "    " + declaracao.paraTexto() + ",\n"
        }
        texto += "  ],\n"
        texto += "  erros: [\n"
        para cada erro em isto.erros {
            texto += "    \"" + erro + "\",\n"
        }
        texto += "  ]\n"
        texto += "}"
        retorna texto
    }
}
